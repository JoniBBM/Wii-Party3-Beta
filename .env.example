# Kopieren nach .env und anpassen. .env wird nicht ins Git übernommen.

# Passwort für die Regie (Pflicht, außer AUTH_DISABLED=true)
ADMIN_PASSWORD=bitte-aendern

# Optional: eigenes Passwort für Moderatoren (sonst Regie-Passwort oder QR-Link aus der Regie)
MODERATOR_PASSWORD=

# Nur zum Testen: Login ohne Passwort für Regie und Moderator
AUTH_DISABLED=false

# Port des Servers
PORT=8080

# Feste öffentliche Adresse, falls auf einem Server mit Domain betrieben
PUBLIC_URL=

# Geheimer Schlüssel für Sitzungen (leer = wird automatisch in data/.secret erzeugt)
APP_SECRET=

# Port auf dem Rechner (Docker)
HOST_PORT=8080
